// Committed template. Never put deployment values here (Compendium 01 Section 3.1).
// `npm run render-config` writes worker/wrangler.jsonc (gitignored) from
// worker/.deploy.env locally, or from GitHub Actions Variables in CI.
// A placeholder without a ":-default" is required; one with a default is optional.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "${WORKER_NAME}",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Serve on <name>.<subdomain>.workers.dev, but no per-version preview URLs:
  // they would be extra public copies of the Worker.
  "workers_dev": true,
  "preview_urls": false,
  // Wanted-poster art and fonts (src/poster-assets.ts). .wasm is bundled by default.
  "rules": [{ "type": "Data", "globs": ["**/*.png", "**/*.ttf"], "fallthrough": false }],
  "d1_databases": [
    { "binding": "DB", "database_name": "${D1_NAME}", "database_id": "${D1_ID}", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "PROOFS", "bucket_name": "${R2_BUCKET}" }],
  // The Discord Gateway connection (spec 7.2). Budget mode (READ_CHAT=false) never starts it.
  "durable_objects": { "bindings": [{ "name": "GATEWAY", "class_name": "GatewayDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GatewayDO"] }],
  // Every minute: reconnect the Gateway if it dropped. Phase 6 adds expiry and weekly jobs.
  "triggers": { "crons": ["*/1 * * * *"] },
  // Phase 6 adds the AI binding.
  "vars": {
    "ALLOWED_GUILD_IDS": "${ALLOWED_GUILD_IDS}",
    "READ_CHAT": "${READ_CHAT:-true}",
    "AI_CHECK": "${AI_CHECK:-true}",
    "AI_DAILY_CAP": "${AI_DAILY_CAP:-200}",
    "PROOF_RETENTION_DAYS": "${PROOF_RETENTION_DAYS:-180}",
    "LOG_LEVEL": "${LOG_LEVEL:-info}",
    // Draw parchment wanted posters (needs Workers Paid CPU time; set false on the Free plan).
    "POSTER_IMAGE": "${POSTER_IMAGE:-true}"
  }
}
