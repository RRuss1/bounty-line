# Copy to worker/.deploy.env (gitignored) for local deploys: npm run deploy
# In CI these come from GitHub Actions Variables instead.
WORKER_NAME=bounty-board
D1_NAME=bounty-board
D1_ID=
R2_BUCKET=bounty-proofs
# Your Discord server ID(s), comma separated. Everything else is refused.
ALLOWED_GUILD_IDS=

# Optional (defaults shown)
# READ_CHAT=true
# AI_CHECK=true
# AI_DAILY_CAP=200
# PROOF_RETENTION_DAYS=180
# LOG_LEVEL=info
